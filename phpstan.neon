parameters:
    level: 8
    paths:
        - src
        - tests
    checkMissingOverrideMethodAttribute: true
    ignoreErrors:
        - '#Trait Dontdrinkandroot\\DoctrineBundle\\Entity\\AssignedIdColumnTrait is used zero times and is not analysed\.$#'
    composerAnalysis:
        ignoreAllShadowDeps: true
        ignoreAllUnusedDeps: true
        ignoreAllProdDepsInDev: true
